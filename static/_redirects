# Cloudflare Pages reads this file from the build output root.
# Hugo copies static/ -> public/ verbatim, so this lands at /_redirects.
# https://developers.cloudflare.com/pages/configuration/redirects/

# www → apex (force 301; preserves path and query)
https://www.entrycardguide.com/*  https://entrycardguide.com/:splat  301!

# Retired Hugo taxonomy pages. These were thin index pages and are not useful
# search landing pages; send old cached URLs to the closest useful hub.
/countries/  /  301
/countries/*  /  301
/tags/  /  301
/tags/*  /  301
/zh/countries/  /zh/  301
/zh/countries/*  /zh/  301
/zh/tags/  /zh/  301
/zh/tags/*  /zh/  301

# Retired middleman-listing pages (18 countries x 2 languages). The site now
# covers only the official URL and how to fill each form; send old URLs to the
# country hub. The /zh/ rule must precede the generic one.
/zh/:country/is-ivisa-official/  /zh/:country/  301
/:country/is-ivisa-official/  /:country/  301
