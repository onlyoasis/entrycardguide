{
  "name": "entrycardguide",
  "version": "0.1.0",
  "private": true,
  "description": "Anti-scam entry card guides. Build-only dependencies: Tailwind + PostCSS for CSS pipeline. No browser-side npm dependencies (v1.0).",
  "scripts": {
    "dev": "hugo server --gc --disableFastRender --bind 127.0.0.1 --destination public-release",
    "predev": "npm run check:public-library",
    "dev:research": "hugo server --gc --disableFastRender --environment research --bind 127.0.0.1 --destination research-public",
    "predev:research": "npm run check:travel-library",
    "build": "node scripts/build-public.mjs",
    "build:prod": "node scripts/build-public.mjs",
    "build:research": "hugo --gc --environment research --destination research-public",
    "prebuild:research": "npm run check:travel-library",
    "check:seo": "node scripts/check-seo-output.mjs public-release",
    "check:public-library": "node scripts/check-public-travel-library.mjs",
    "export:public-library": "node scripts/export-public-travel-library.mjs",
    "check:data-boundary": "node scripts/check-data-boundary.mjs --index",
    "check:public-output": "node scripts/check-public-output.mjs",
    "install:data-hooks": "node scripts/install-data-hooks.mjs",
    "test:data-protection": "node --test tests/*boundary.test.mjs tests/public-output.test.mjs tests/travel-library-public.test.mjs tests/indexnow-output.test.mjs",
    "check:travel-library": "node scripts/check-travel-library.mjs",
    "verify:official-urls": "node scripts/verify-official-urls.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs --public-dir public-release",
    "fetch:search-data": "node scripts/fetch-search-data.mjs",
    "check:index-status": "node scripts/check-index-status.mjs",
    "clean": "rm -rf public-release research-public resources"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.4"
  }
}
